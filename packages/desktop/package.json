{
	"name": "@sola_mpd/desktop",
	"productName": "sola_mpd",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "dist/main/index.mjs",
	"scripts": {
		"build": "tsc --noEmit && tsdown",
		"build:no_types": "tsdown",
		"dev": "tsdown && ELECTRON_RUN_AS_NODE= electron dist/main/index.mjs --no-sandbox",
		"dist": "node scripts/dist.mjs",
		"test": "vitest run --passWithNoTests",
		"test:e2e": "install-electron && xvfb-run --auto-servernum playwright test"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.17.0",
		"@connectrpc/connect": "^2.3.0",
		"@connectrpc/connect-node": "^2.3.0",
		"@prokosna/mpd3": "^2.1.0",
		"@sola_mpd/shared": "workspace:*",
		"dayjs": "^1.11.23"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@types/node": "^24.19.2",
		"electron": "^45.4.1",
		"electron-builder": "^26.18.0",
		"tsdown": "^0.23.7"
	}
}
